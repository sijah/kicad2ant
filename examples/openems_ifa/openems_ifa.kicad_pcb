 (pad "1" smd rect (at 0.5 -4.25) (size 1 7.5) (layers "F.Cu") (net 2 "RF"))
 (pad "2" smd rect (at -6.0 -4.0) (size 4 8) (layers "F.Cu") (net 1 "GND"))
 (fp_rect (start -8 -8) (end 14.5 -5.5) (stroke (width 0)) (fill solid) (layer "F.Cu")))
(gr_rect (start 60 60) (end 140 140) (stroke (width 0.1)) (layer "Edge.Cuts"))
(zone (net 1) (net_name "GND") (layer "F.Cu") (connect_pads yes (clearance 0.2)) (min_thickness 0.25)
 (polygon (pts (xy 60 70) (xy 140 70) (xy 140 140) (xy 60 140))) (filled_polygon (layer "F.Cu") (pts (xy 60 70) (xy 140 70) (xy 140 140) (xy 60 140))))
