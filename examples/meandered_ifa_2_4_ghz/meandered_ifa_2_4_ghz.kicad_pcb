  "Meandered_IFA__2.4_GHz"
  (at 100 100)
  (version 20221018)
  (generator pcb_antenna_designer)
  (layer "F.Cu")
  (descr "Meandered inverted-F antenna for 2.4 GHz on a small board (15.5 x 25 mm ground): a short to ground, the feed 1.5 mm from it, then six meander legs. Matched to 50 ohm without a network (S11 about -35 dB at 2.45 GHz, -10 dB band about 2.40-2.50 GHz). Two parameters tune it: LM, the leg length, sets the frequency; D, the distance from the short to the feed, sets the impedance. The ground plane is part of the antenna: results change with your board size.")
  (tags "antenna IFA MIFA RF")
  (attr smd)
  (net_tie_pad_groups "1, 2")
