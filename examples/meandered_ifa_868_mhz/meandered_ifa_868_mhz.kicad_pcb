  (at 100 100)
  (version 20221018)
  (generator pcb_antenna_designer)
  (layer "F.Cu")
  (descr "Meandered inverted-F antenna: a quarter wavelength at 868 MHz folded into a meander along the board edge, with a short to ground 4 mm from the feed. The short raises the impedance to about 50 ohm, so it matches without a network (S11 about -23 dB, -10 dB band about 855-880 MHz). For sub-GHz IoT (LoRa, Sigfox, wM-Bus). LM tunes the frequency, D the impedance. The ground plane is part of the antenna: results change with your board size.")
