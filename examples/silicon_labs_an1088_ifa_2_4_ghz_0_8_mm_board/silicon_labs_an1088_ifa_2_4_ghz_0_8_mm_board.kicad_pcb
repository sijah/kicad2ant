  "Silicon_Labs_AN1088_IFA__2.4_GHz__0.8_mm_board"
  (at 100 100)
  (version 20221018)
  (generator pcb_antenna_designer)
  (layer "F.Cu")
  (descr "Inverted-F antenna from Silicon Labs AN1088 (EM250/EM260 reference designs), dimensions from its Figure 2.1 and stackup from Figure 2.2: 4 layers, ground on layers 2 and 4 stitched with vias, no ground under the antenna, a 50 ohm (14 mil) microstrip feed. On the 0.8 mm EM260 board Silicon Labs found the antenna matched to 50 ohm with no matching components. The note does not give the ground plane size (it depends on the board): 30 x 40 mm here. Parameter values in mm (the note uses inches). Tuned in a commercial EM tool for 2.44 GHz without a matching network: the arm lowered to H = 5 mm and lengthened to L = 22.694 mm (AN1088: H 7.899, L 21.844, S11 about -10 dB, Silicon Labs matched it with components). Accurate run: S11 -22.7 dB at 2.44 GHz (Z 53 - j7 ohm), -10 dB band 2.28-2.665 GHz, total efficiency 93 %, realized gain 2.5 dBi.")
  (tags "antenna IFA MIFA RF")
  (attr smd)
  (net_tie_pad_groups "1, 2")
